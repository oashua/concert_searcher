#!/bin/sh
# Update script.js update date based on data.js timestamp

repo_root="$(git rev-parse --show-toplevel)"

if command -v bash >/dev/null 2>&1; then
  bash "$repo_root/scripts/update-last-update.sh"
elif command -v sh >/dev/null 2>&1; then
  sh "$repo_root/scripts/update-last-update.sh"
else
  echo "bash/sh not found; skip update-last-update.sh"
fi

git add "$repo_root/script.js"
