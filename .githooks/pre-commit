#!/bin/sh
# Update script.js update date based on data.js timestamp

repo_root="$(git rev-parse --show-toplevel)"

if command -v python >/dev/null 2>&1; then
  python "$repo_root/scripts/update-last-update.py"
elif command -v python3 >/dev/null 2>&1; then
  python3 "$repo_root/scripts/update-last-update.py"
else
  echo "python not found; skip update-last-update.py"
fi

git add "$repo_root/script.js"
